# Tableau Public username (the part after public.tableau.com/app/profile/)
TABLEAU_USERNAME=your_username_here

# Google Spreadsheet ID (from the URL: https://docs.google.com/spreadsheets/d/{THIS_PART}/edit)
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Google service account credentials JSON (for GitHub Actions, set as a secret)
# Option 1: JSON string (recommended for CI/CD)
GOOGLE_CREDENTIALS_JSON=

# Option 2: Path to credentials file (for local development)
GOOGLE_CREDENTIALS_PATH=credentials.json
